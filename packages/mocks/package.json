  },
  "dependencies": {
    "@sp/schemas": "workspace:*",
    "@sp/types": "workspace:*",
    "@sp/utils": "workspace:*",
    "msw": "^2.15.0"
  },
  "devDependencies": {
    "@sp/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

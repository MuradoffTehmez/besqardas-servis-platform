{
  "name": "@sp/mocks",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./handlers": "./src/handlers/index.ts",
    "./autostart": "./src/autostart.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",

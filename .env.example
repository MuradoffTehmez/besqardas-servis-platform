# Server-side API. Phase 1-də lokal Mock API istifadə olunur.
MOCK_API_URL=http://127.0.0.1:4000

# MOCK_API_URL verilmədikdə server API client üçün alternativ ünvan.
# API_URL=https://api.example.com

# Canonical, Open Graph, sitemap və robots üçün public sayt ünvanı.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web və admin tətbiqləri arasında keçidlər.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Xarici Mock API ayrıca başladılıbsa autostart-ı söndürün.
# MOCK_AUTOSTART=0

# Demo idarəetmə panelini gizlətmək üçün 1 təyin edin.
# NEXT_PUBLIC_HIDE_MOCK_PANEL=1

# Playwright override-ları.
# E2E_WEB_URL=http://localhost:3000
# E2E_ADMIN_URL=http://localhost:3001
# E2E_API_URL=http://127.0.0.1:4000
# PW_CHANNEL=chrome

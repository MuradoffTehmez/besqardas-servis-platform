{
  "name": "service-platform",
  "private": true,
  "version": "0.3.2",
  "description": "besqardasServis.az — Servis İdarəetmə Platforması (Phase 1 — Frontend)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@sp/mocks --filter=@sp/web --parallel",
    "dev:admin": "turbo run dev --filter=@sp/mocks --filter=@sp/admin --parallel",
    "mock": "pnpm --filter @sp/mocks dev",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && node scripts/check-i18n.mjs && pnpm test && pnpm build",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
